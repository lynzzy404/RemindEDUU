# Dependencies
/vendor/

# Local configuration and secrets
.env
.env.*
!.env.example
/config/config.local.php
/config/*.local.php

# Runtime data (never commit user data, hashes, logs, or temporary files)
/storage/data/*.json
/storage/data/*.json.lock
/storage/data/backup/
/storage/logs/*
/storage/ratelimit/*
/storage/tmp/*

# Preserve required runtime directory markers and web-server protections
!/storage/data/index.html
!/storage/logs/.gitkeep
!/storage/ratelimit/.gitkeep
!/storage/tmp/.gitkeep
!/storage/.htaccess
!/storage/data/.htaccess

# Local development and editor files
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
*.code-workspace

# Temporary and generated artifacts
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
